        "\[Eta]x", ",", "\[Eta]z", ",", "\[Kappa]", ",", "\[Kappa]p", ",", 
        "kp", ",", "\[Mu]", ",", "Bx", ",", "e", ",", "vz", ",", "u"}], "}"}],
       "\[Element]", " ", "Reals"}], " ", "&&", " ", 
     RowBox[{"v0", ">", "0"}], " ", "&&", " ", 
     RowBox[{"\[Mu]", ">=", "0"}], " ", "&&", 
     RowBox[{"\[Mu]", "<", 
      RowBox[{"k0", " ", "v0"}]}], "  ", "&&", " ", 
     RowBox[{"k0", ">", "0"}], " ", "&&", "  ", 
