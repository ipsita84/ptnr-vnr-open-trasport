Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"ex", "=", 
  RowBox[{
   RowBox[{"Simplify", "[", 
    RowBox[{
     FractionBox["1", 
      RowBox[{"8", " ", 
       SuperscriptBox["\[Pi]", "2"], " ", 
       SuperscriptBox["\[Eta]x", "3"], " ", "\[Mu]"}]], 
     RowBox[{"(", 
      RowBox[{
       RowBox[{
        RowBox[{"-", "\[Pi]"}], " ", 
        SuperscriptBox["\[Eta]x", "2"], " ", "\[Mu]", " ", "0"}], "+", 
       RowBox[{
        FractionBox[
         RowBox[{"2", " ", 
          SqrtBox[
           RowBox[{
            RowBox[{"\[Eta]tilde", "^", "2"}], "-", 
            RowBox[{"\[Mu]", "^", "2"}]}]], " ", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"-", "\[Eta]tilde"}], "+", 
            SqrtBox[
             RowBox[{
              RowBox[{"\[Eta]tilde", "^", "2"}], "-", 
              RowBox[{
               RowBox[{"\[Eta]x", "^", "2"}], " ", 
               RowBox[{"\[Mu]", "^", "2"}]}]}]]}], ")"}]}], "\[Eta]tilde"], 
        "0"}], "+", " ", 
       RowBox[{
        SuperscriptBox["\[Eta]x", "2"], " ", "\[Mu]", " ", 
        RowBox[{"ArcCos", "[", 
         FractionBox["\[Mu]", "\[Eta]tilde"], "]"}], "0"}], "+", " ", 
       RowBox[{"2", " ", "\[Eta]x", " ", "\[Mu]", " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"EllipticE", "[", 
           RowBox[{
            RowBox[{"ArcSin", "[", "\[Eta]x", "]"}], ",", 
            FractionBox["1", 
             SuperscriptBox["\[Eta]x", "2"]]}], "]"}], "+", 
          RowBox[{"EllipticE", "[", 
           RowBox[{
            RowBox[{"ArcSin", "[", 
             FractionBox[
              RowBox[{"\[Eta]x", " ", "\[Mu]"}], "\[Eta]tilde"], "]"}], ",", 
            FractionBox["1", 
             SuperscriptBox["\[Eta]x", "2"]]}], "]"}]}], ")"}]}]}], ")"}]}], 
    "]"}], "/.", "rep1"}]}], "\[IndentingNewLine]", 
 RowBox[{"TeXForm", "[", "ex", "]"}]}], "Input",
 CellChangeTimes->{{3.979288036737691*^9, 3.979288064092124*^9}, {
  3.979288100452568*^9, 3.979288101817298*^9}, {3.979289258970573*^9, 
  3.979289289495041*^9}, {3.9792894487406187`*^9, 3.979289509685082*^9}, {
