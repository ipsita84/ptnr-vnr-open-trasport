Cell[BoxData[{
 RowBox[{
  RowBox[{"$PrePrint", "=", 
   RowBox[{
    RowBox[{"#", "/.", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{"Csc", "[", "z_", "]"}], ":>", 
        RowBox[{"1", "/", 
         RowBox[{"Defer", "@", 
          RowBox[{"Sin", "[", "z", "]"}]}]}]}], ",", 
       RowBox[{
        RowBox[{"Sec", "[", "z_", "]"}], ":>", 
        RowBox[{"1", "/", 
         RowBox[{"Defer", "@", 
          RowBox[{"Cos", "[", "z", "]"}]}]}]}], ",", 
       RowBox[{
        RowBox[{"Tan", "[", "z_", "]"}], ":>", 
        RowBox[{
         RowBox[{"Defer", "@", 
          RowBox[{"Sin", "[", "z", "]"}]}], "/", 
         RowBox[{"Defer", "@", 
          RowBox[{"Cos", "[", "z", "]"}]}]}]}], ",", 
       RowBox[{
        RowBox[{"Cot", "[", "z_", "]"}], ":>", 
        RowBox[{
         RowBox[{"Defer", "@", 
          RowBox[{"Cos", "[", "z", "]"}]}], "/", 
         RowBox[{"Defer", "@", 
          RowBox[{"Sin", "[", "z", "]"}]}]}]}]}], "}"}]}], "&"}]}], ";", 
  RowBox[{"rep", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"kx", "\[Rule]", 
      RowBox[{"kp", " ", 
       RowBox[{"Cos", "[", "\[Phi]", "]"}]}]}], ",", 
     RowBox[{"ky", "\[Rule]", 
      RowBox[{"kp", " ", 
       RowBox[{"Sin", "[", "\[Phi]", "]"}]}]}], ",", 
     RowBox[{"kz", "\[Rule]", " ", "kz"}]}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"rep1", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"kx", "->", 
      SubscriptBox["k", "x"]}], ",", 
     RowBox[{"ky", "->", 
      SubscriptBox["k", "y"]}], ",", 
     RowBox[{"kp", "->", 
      SubscriptBox["k", "p"]}], ",", 
     RowBox[{"Bx", "->", "B"}], ",", 
     RowBox[{"v0", "->", 
      SubscriptBox["v", "0"]}], ",", 
     RowBox[{"\[Eta]x", "->", 
      SubscriptBox["\[Eta]", "x"]}], ",", 
     RowBox[{"\[Eta]z", "->", 
      SubscriptBox["\[Eta]", "z"]}], ",", 
     RowBox[{"k0", "->", 
      SubscriptBox["k", "0"]}], ",", 
     RowBox[{"\[Eta]tilde", "->", 
      OverscriptBox["\[Eta]", "~"]}]}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"ass", "=", 
   RowBox[{"Assumptions", "->", 
    RowBox[{
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "kp", ",", "k0", ",", "\[Gamma]", ",", "\[Eta]tilde", ",", "\[Phi]", ",",
