  3.9792929988435802`*^9}, {3.979293234770441*^9, 3.9792932915860863`*^9}, {
  3.979293368277569*^9, 3.979293375589716*^9}, {3.979293435087648*^9, 
  3.979293437696384*^9}},
 CellLabel->"In[49]:=",ExpressionUUID->"7cc006c9-d9d8-49cf-b8db-3432330a6993"],

Cell[BoxData[
 FractionBox[
  RowBox[{
   RowBox[{"EllipticE", "[", 
    RowBox[{
     RowBox[{"ArcSin", "[", 
      SubscriptBox["\[Eta]", "x"], "]"}], ",", 
     FractionBox["1", 
      SubsuperscriptBox["\[Eta]", "x", "2"]]}], "]"}], "+", 
   RowBox[{"EllipticE", "[", 
    RowBox[{
     RowBox[{"ArcSin", "[", 
      FractionBox[
       RowBox[{"\[Mu]", " ", 
        SubscriptBox["\[Eta]", "x"]}], 
       OverscriptBox["\[Eta]", "~"]], "]"}], ",", 
     FractionBox["1", 
      SubsuperscriptBox["\[Eta]", "x", "2"]]}], "]"}]}], 
  RowBox[{"4", " ", 
   SuperscriptBox["\[Pi]", "2"], " ", 
   SubsuperscriptBox["\[Eta]", "x", "2"]}]]], "Output",
