Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", "OMM", " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"Clear", "[", 
     RowBox[{"mtx", ",", " ", "mty", ",", " ", "mtz"}], "]"}], ";", 
    RowBox[{
     RowBox[{"mtx", "[", "i_", "]"}], ":=", 
     RowBox[{
      RowBox[{"-", "\[ImaginaryI]"}], 
      FractionBox["e", "2"], 
      RowBox[{
       UnderoverscriptBox["\[Sum]", 
        RowBox[{"j", "=", "1"}], "3"], 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"j", "\[NotEqual]", "i"}], ",", " ", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{
             RowBox[{"(", 
              RowBox[{
               RowBox[{"vectdag", "[", 
                RowBox[{"[", "i", "]"}], "]"}], ".", 
               RowBox[{"(", 
                RowBox[{"derty", ".", 
                 RowBox[{"vect", "[", 
                  RowBox[{"[", "j", "]"}], "]"}]}], ")"}]}], ")"}], "*", 
             RowBox[{"(", 
              RowBox[{
               RowBox[{"vectdag", "[", 
                RowBox[{"[", "j", "]"}], "]"}], ".", 
               RowBox[{"(", 
                RowBox[{"derz", ".", 
                 RowBox[{"vect", "[", 
                  RowBox[{"[", "i", "]"}], "]"}]}], ")"}]}], ")"}]}], "-", 
