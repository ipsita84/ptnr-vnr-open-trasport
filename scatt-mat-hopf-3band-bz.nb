Cell[BoxData[{
 RowBox[{
  RowBox[{"Clear", "[", 
   RowBox[{"sig", ",", "sol1", ",", "sol2", ",", "sol3"}], "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"sig", "[", 
     RowBox[{"B_", ",", "\[Mu]_", ",", "v0_", ",", "\[Beta]_"}], "]"}], ":=", 
    
    RowBox[{"Block", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"e", "=", "1"}], ",", "BCvec", ",", "v0vec", ",", 
        RowBox[{"vf", "=", "v0"}], ",", "vmvec", ",", "matr", ",", "rhs1", ",",
         "rhs2", ",", "\[Theta]", ",", "\[Tau]", ",", "kf", ",", "f", ",", 
        "vdotk", ",", "cs", ",", "\[Lambda]1", ",", "a1", ",", "b1", ",", 
        "cost", ",", "\[Theta]p", ",", "\[Phi]", ",", "Dphase", ",", "h", ",",
         "hzero", ",", "hct", ",", "hc2t", ",", "zero", ",", "ct", ",", "c2t",
         ",", "ctsq", ",", "c2tsq", ",", "ctc2t", ",", "colvec", ",", "mat", ",",
         "sol", ",", "sol1", ",", "sol2", ",", "sol3", ",", 
        "\[CapitalLambda]1", ",", "s1", ",", "int1"}], "}"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        RowBox[{"kf", "[", "\[Theta]_", "]"}], "=", "  ", 
        FractionBox[
         RowBox[{"\[Mu]", "+", 
          SqrtBox[
           RowBox[{
            SuperscriptBox["\[Mu]", "2"], "-", 
            RowBox[{"2", "vf", " ", "vf", "  ", "B", " ", "e", " ", 
             SuperscriptBox[
              RowBox[{"Cos", "[", "\[Theta]", "]"}], "2"]}]}]]}], 
         RowBox[{"2", " ", "vf"}]]}], ";", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"BCvec", "[", "\[Theta]_", "]"}], "=", 
        RowBox[{
         FractionBox[
          RowBox[{"Cos", "[", "\[Theta]", "]"}], 
          SuperscriptBox[
           RowBox[{"kf", "[", "\[Theta]", "]"}], "2"]], 
         RowBox[{"{", " ", 
          RowBox[{
           RowBox[{
            RowBox[{"Cos", "[", "\[Phi]", "]"}], " ", 
            RowBox[{"Sin", "[", "\[Theta]", "]"}]}], ",", " ", 
           RowBox[{
            RowBox[{"Sin", "[", "\[Theta]", "]"}], " ", 
            RowBox[{"Sin", "[", "\[Phi]", "]"}]}], ",", 
           RowBox[{"Cos", "[", "\[Theta]", "]"}]}], "}"}]}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"Dphase", "[", "\[Theta]_", "]"}], "=", 
        RowBox[{"1", " ", "+", 
         RowBox[{"e", " ", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"BCvec", "[", "\[Theta]", "]"}], ")"}], "[", 
           RowBox[{"[", "3", "]"}], "]"}], " ", "B"}]}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"v0vec", "[", "\[Theta]_", "]"}], "=", 
        RowBox[{"vf", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{
            RowBox[{"Cos", "[", "\[Phi]", "]"}], " ", 
            RowBox[{"Sin", "[", "\[Theta]", "]"}]}], ",", 
           RowBox[{
            RowBox[{"Sin", "[", "\[Theta]", "]"}], " ", 
            RowBox[{"Sin", "[", "\[Phi]", "]"}]}], ",", " ", 
           RowBox[{"Cos", "[", "\[Theta]", "]"}]}], "}"}]}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"-", 
           FractionBox[
            RowBox[{"3", " ", "B", " ", "chi", " ", "e", " ", "vf", " ", 
             SuperscriptBox[
              RowBox[{"Cos", "[", "\[Theta]", "]"}], "2"], " ", 
             RowBox[{"Cos", "[", "\[Phi]", "]"}], " ", 
             RowBox[{"Sin", "[", "\[Theta]", "]"}]}], 
            RowBox[{"2", " ", 
             SuperscriptBox["k", "2"]}]]}], ",", 
          RowBox[{"-", 
           FractionBox[
            RowBox[{"3", " ", "B", " ", "chi", " ", "e", " ", "vf", " ", 
             SuperscriptBox[
              RowBox[{"Cos", "[", "\[Theta]", "]"}], "2"], " ", 
             RowBox[{"Sin", "[", "\[Theta]", "]"}], " ", 
             RowBox[{"Sin", "[", "\[Phi]", "]"}]}], 
            RowBox[{"2", " ", 
             SuperscriptBox["k", "2"]}]]}], ",", 
          RowBox[{"-", 
           FractionBox[
            RowBox[{"B", " ", "chi", " ", "e", " ", "vf", " ", 
             RowBox[{"(", 
              RowBox[{
               RowBox[{"Cos", "[", "\[Theta]", "]"}], "+", 
               RowBox[{"3", " ", 
                RowBox[{"Cos", "[", 
                 RowBox[{"3", " ", "\[Theta]"}], "]"}]}]}], ")"}]}], 
            RowBox[{"8", " ", 
             SuperscriptBox["k", "2"]}]]}]}], "}"}], "*)"}], 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"vmvec", "[", "\[Theta]_", "]"}], "=", 
        RowBox[{
         RowBox[{"-", " ", "vf"}], "  ", "e", " ", "B", 
         RowBox[{"{", 
          RowBox[{
           FractionBox[
            RowBox[{"3", "  ", 
             SuperscriptBox[
              RowBox[{"Cos", "[", "\[Theta]", "]"}], "2"], " ", 
             RowBox[{"Cos", "[", "\[Phi]", "]"}], " ", 
             RowBox[{"Sin", "[", "\[Theta]", "]"}]}], 
            RowBox[{"2", " ", 
             SuperscriptBox[
              RowBox[{"kf", "[", "\[Theta]", "]"}], "2"]}]], ",", 
           FractionBox[
            RowBox[{"3", " ", 
             SuperscriptBox[
              RowBox[{"Cos", "[", "\[Theta]", "]"}], "2"], " ", 
             RowBox[{"Sin", "[", "\[Theta]", "]"}], " ", 
             RowBox[{"Sin", "[", "\[Phi]", "]"}]}], 
            RowBox[{"2", " ", 
             SuperscriptBox[
              RowBox[{"kf", "[", "\[Theta]", "]"}], "2"], " "}]], ",", 
           FractionBox[
            RowBox[{" ", 
             RowBox[{
              RowBox[{"Cos", "[", "\[Theta]", "]"}], "+", 
              RowBox[{"3", " ", 
               RowBox[{"Cos", "[", 
                RowBox[{"3", " ", "\[Theta]"}], "]"}]}]}]}], 
            RowBox[{"8", " ", 
             SuperscriptBox[
              RowBox[{"kf", "[", "\[Theta]", "]"}], "2"]}]]}], "}"}]}]}], ";",
        "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"vdotk", "[", "\[Theta]_", "]"}], "=", 
        RowBox[{
         RowBox[{
          RowBox[{"kf", "[", "\[Theta]", "]"}], " ", "vf"}], "-", 
         FractionBox[
          RowBox[{"B", " ", "e", " ", "vf", "  ", 
           SuperscriptBox[
            RowBox[{"Cos", "[", "\[Theta]", "]"}], "2"]}], 
          RowBox[{"2", " ", 
           RowBox[{"kf", "[", "\[Theta]", "]"}]}]]}]}], ";", 
       RowBox[{"(*", " ", 
        RowBox[{"-", 
         FractionBox[
          RowBox[{"B", " ", "chi", " ", "e", " ", "vf", " ", 
           SuperscriptBox[
            RowBox[{"Cos", "[", "\[Theta]", "]"}], "2"]}], 
          RowBox[{"2", " ", "k"}]]}], " ", "*)"}], "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"h", "[", "\[Theta]_", "]"}], "=", 
        RowBox[{
         FractionBox["1", 
          RowBox[{"Dphase", "[", "\[Theta]", "]"}]], 
         RowBox[{"(", 
          RowBox[{
           RowBox[{
            RowBox[{"(", 
             RowBox[{
              RowBox[{"v0vec", "[", "\[Theta]", "]"}], "+", 
              RowBox[{"vmvec", "[", "\[Theta]", "]"}]}], ")"}], "[", 
            RowBox[{"[", "3", "]"}], "]"}], "-", 
           RowBox[{"e", " ", "B", " ", 
            FractionBox[
             RowBox[{"vf", " ", 
              RowBox[{"Cos", "[", "\[Theta]", "]"}], " ", 
              RowBox[{"(", 
               RowBox[{
                RowBox[{"B", " ", "e"}], "-", 
                RowBox[{"4", " ", 
                 SuperscriptBox[
                  RowBox[{"kf", "[", "\[Theta]", "]"}], "2"]}], " ", "+", 
                RowBox[{"B", " ", "e", " ", 
                 RowBox[{"Cos", "[", 
                  RowBox[{"2", " ", "\[Theta]"}], "]"}]}]}], ")"}]}], 
             RowBox[{"4", " ", 
              SuperscriptBox[
               RowBox[{"kf", "[", "\[Theta]", "]"}], "4"], " "}]]}]}], 
          ")"}]}]}], ";", 
       RowBox[{"(*", " ", 
        RowBox[{"-", 
         FractionBox[
          RowBox[{"chi", " ", "vf", " ", 
           RowBox[{"Cos", "[", "\[Theta]", "]"}], " ", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"B", " ", "chi", " ", "e"}], "-", 
             RowBox[{"4", " ", 
              SuperscriptBox["k", "2"]}], "+", 
             RowBox[{"B", " ", "chi", " ", "e", " ", 
              RowBox[{"Cos", "[", 
               RowBox[{"2", " ", "\[Theta]"}], "]"}]}]}], ")"}]}], 
          RowBox[{"4", " ", 
           SuperscriptBox["k", "4"]}]]}], " ", "*)"}], "\[IndentingNewLine]", 
       
