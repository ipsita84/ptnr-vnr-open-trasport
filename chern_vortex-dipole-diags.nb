Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"stackPlots", "[", 
    RowBox[{
     RowBox[{"plots2D", ":", 
      RowBox[{"{", "__Graphics", "}"}]}], ",", "dh_", ",", 
     RowBox[{"o", ":", 
      RowBox[{"OptionsPattern", "[", "Graphics3D", "]"}]}]}], "]"}], ":=", 
   RowBox[{"Graphics3D", "[", 
    RowBox[{
     RowBox[{"MapIndexed", "[", 
      RowBox[{
       RowBox[{"Function", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"g", ",", "index"}], "}"}], ",", 
         RowBox[{
          RowBox[{"g", "[", 
           RowBox[{"[", "1", "]"}], "]"}], "/.", 
          RowBox[{
           RowBox[{"Arrow", "[", "v2d_", "]"}], "\[RuleDelayed]", 
           RowBox[{"Arrow", "[", 
            RowBox[{"v2d", "/.", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{
                RowBox[{"x_", "?", "NumericQ"}], ",", 
                RowBox[{"y_", "?", "NumericQ"}]}], "}"}], "\[RuleDelayed]", 
              RowBox[{"{", 
               RowBox[{"x", ",", "y", ",", 
                RowBox[{"dh", " ", 
                 RowBox[{"index", "[", 
                  RowBox[{"[", "1", "]"}], "]"}]}]}], "}"}]}]}], "]"}]}]}]}], 
        "]"}], ",", "plots2D"}], "]"}], ",", "o"}], "]"}]}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"values", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"-", "1"}], ",", "0", ",", "1"}], "}"}]}], ";", 
  RowBox[{"plots", "=", 
   RowBox[{"MapIndexed", "[", 
    RowBox[{
     RowBox[{"Function", "[", 
      RowBox[{
       RowBox[{"{", 
