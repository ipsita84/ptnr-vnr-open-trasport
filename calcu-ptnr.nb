Cell[BoxData[{
 RowBox[{
  RowBox[{"$PrePrint", "=", 
   RowBox[{
    RowBox[{"#", "/.", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{"Csc", "[", "z_", "]"}], ":>", 
        RowBox[{"1", "/", 
         RowBox[{"Defer", "@", 
          RowBox[{"Sin", "[", "z", "]"}]}]}]}], ",", 
       RowBox[{
        RowBox[{"Sec", "[", "z_", "]"}], ":>", 
        RowBox[{"1", "/", 
         RowBox[{"Defer", "@", 
          RowBox[{"Cos", "[", "z", "]"}]}]}]}], ",", 
       RowBox[{
        RowBox[{"Tan", "[", "z_", "]"}], ":>", 
        RowBox[{
         RowBox[{"Defer", "@", 
          RowBox[{"Sin", "[", "z", "]"}]}], "/", 
         RowBox[{"Defer", "@", 
          RowBox[{"Cos", "[", "z", "]"}]}]}]}], ",", 
       RowBox[{
        RowBox[{"Cot", "[", "z_", "]"}], ":>", 
        RowBox[{
         RowBox[{"Defer", "@", 
          RowBox[{"Cos", "[", "z", "]"}]}], "/", 
         RowBox[{"Defer", "@", 
          RowBox[{"Sin", "[", "z", "]"}]}]}]}]}], "}"}]}], "&"}]}], ";", 
  RowBox[{"rep", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"kx", "\[Rule]", 
      RowBox[{"k0", " ", 
       RowBox[{"Cos", "[", "\[Phi]", "]"}]}]}], ",", 
     RowBox[{"ky", "\[Rule]", 
      RowBox[{"k0", " ", 
       RowBox[{"Sin", "[", "\[Phi]", "]"}]}]}], ",", 
     RowBox[{"kz", "\[Rule]", " ", "0"}], ",", 
     RowBox[{"\[Kappa]p", "->", "0"}], ",", 
     RowBox[{"\[Kappa]", "->", "0"}]}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"rep1", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"kx", "->", 
      SubscriptBox["k", "x"]}], ",", 
     RowBox[{"ky", "->", 
      SubscriptBox["k", "y"]}], ",", 
     RowBox[{"kp", "->", 
      SubscriptBox["k", "p"]}], ",", 
     RowBox[{"Bx", "->", "B"}], ",", 
     RowBox[{"v0", "->", 
      SubscriptBox["v", "0"]}], ",", 
     RowBox[{"\[Eta]x", "->", 
      SubscriptBox["\[Eta]", "x"]}], ",", 
     RowBox[{"\[Eta]z", "->", 
      SubscriptBox["\[Eta]", "z"]}], ",", 
     RowBox[{"k0", "->", 
      SubscriptBox["k", "0"]}], ",", 
     RowBox[{"\[Eta]tilde", "->", 
      OverscriptBox["\[Eta]", "~"]}]}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"ass", "=", 
   RowBox[{"Assumptions", "->", 
    RowBox[{
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "kp", ",", "k0", ",", "\[Gamma]", ",", "\[Theta]", ",", "\[Phi]", ",", 
        "v0", ",", "kx", ",", "ky", ",", "\[Epsilon]", ",", "\[Eta]", ",", 
        "\[Kappa]", ",", "\[Kappa]p", ",", "kp", ",", "\[Mu]"}], "}"}], "\[Element]",
       " ", "Reals"}], " ", "&&", " ", 
     RowBox[{"v0", ">", "0"}], " ", "&&", " ", 
     RowBox[{"kp", ">", "0"}], "  ", "&&", " ", 
     RowBox[{"k0", ">", "0"}], " ", "&&", "  ", 
     RowBox[{"\[Kappa]", ">", "0"}], "  ", "&&", " ", 
