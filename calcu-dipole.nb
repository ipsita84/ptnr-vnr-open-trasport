          FractionBox["1", "2"], " ", 
          RowBox[{"(", 
           RowBox[{"3", "+", "m", "+", "n"}], ")"}]}], ",", 
         SuperscriptBox["\[Eta]z", "2"]}], "]"}]}]}], ")"}]}]}], 
