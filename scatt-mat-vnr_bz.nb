Cell[BoxData[
 RowBox[{"(*", " ", 
  RowBox[{"eigensystem", ":", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"-", "\[Epsilon]"}], ",", "\[Epsilon]"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         FractionBox[
          RowBox[{
           SuperscriptBox["\[ExponentialE]", 
            RowBox[{
             RowBox[{"-", "\[ImaginaryI]"}], " ", "\[Phi]"}]], " ", 
           RowBox[{"(", 
            RowBox[{
             FractionBox["\[Epsilon]", "v0"], "-", "\[Kappa]p"}], ")"}]}], 
          "kz"], ",", "1"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"-", 
          FractionBox[
           RowBox[{
            SuperscriptBox["\[ExponentialE]", 
             RowBox[{
              RowBox[{"-", "\[ImaginaryI]"}], " ", "\[Phi]"}]], " ", 
            RowBox[{"(", 
             RowBox[{"\[Epsilon]", "+", 
              RowBox[{"v0", " ", "\[Kappa]p"}]}], ")"}]}], 
           RowBox[{"kz", " ", "v0"}]]}], ",", "1"}], "}"}]}], "}"}]}], 
    "}"}]}], " ", "*)"}]], "Input",
 CellChangeTimes->{{3.976266781093689*^9, 
  3.9762667921060343`*^9}},ExpressionUUID->"69e6ecd2-94e3-437c-a968-\
261d0089f6fb"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"Clear", "[", 
   RowBox[{"vecp", ",", "vecpdag", ",", "vecm", ",", "vecmdag"}], "]"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"vecm", "[", 
    RowBox[{"\[Gamma]_", ",", "\[Phi]_"}], "]"}], "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Sin", "[", 
      FractionBox["\[Gamma]", "2"], "]"}], ",", " ", 
     RowBox[{
      SuperscriptBox["\[ExponentialE]", 
       RowBox[{"\[ImaginaryI]", " ", "\[Phi]"}]], " ", 
      RowBox[{"Cos", "[", 
       FractionBox["\[Gamma]", "2"], "]"}]}]}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"vecmdag", "[", 
    RowBox[{"\[Gamma]_", ",", "\[Phi]_"}], "]"}], "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Sin", "[", 
      FractionBox["\[Gamma]", "2"], "]"}], ",", " ", 
     RowBox[{
      SuperscriptBox["\[ExponentialE]", 
       RowBox[{
        RowBox[{"-", "\[ImaginaryI]"}], " ", "\[Phi]"}]], " ", 
      RowBox[{"Cos", "[", 
       FractionBox["\[Gamma]", "2"], "]"}]}]}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"normm", "="}], "*)"}], 
  RowBox[{"FullSimplify", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"vecmdag", "[", 
      RowBox[{"\[Gamma]", ",", "\[Phi]"}], "]"}], ".", 
     RowBox[{"vecm", "[", 
      RowBox[{"\[Gamma]", ",", "\[Phi]"}], "]"}]}], ",", "ass"}], "]"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"vecp", "[", 
    RowBox[{"\[Gamma]_", ",", "\[Phi]_"}], "]"}], "=", 
   RowBox[{"{", " ", 
    RowBox[{
     RowBox[{"Cos", "[", 
      FractionBox["\[Gamma]", "2"], "]"}], ",", 
     RowBox[{
      RowBox[{"-", " ", 
       SuperscriptBox["\[ExponentialE]", 
        RowBox[{"\[ImaginaryI]", " ", "\[Phi]"}]]}], " ", 
      RowBox[{"Sin", "[", 
       FractionBox["\[Gamma]", "2"], "]"}]}]}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"vecpdag", "[", 
    RowBox[{"\[Gamma]_", ",", "\[Phi]_"}], "]"}], "=", 
   RowBox[{"{", " ", 
    RowBox[{
     RowBox[{"Cos", "[", 
      FractionBox["\[Gamma]", "2"], "]"}], ",", 
     RowBox[{
      RowBox[{"-", " ", 
       SuperscriptBox["\[ExponentialE]", 
        RowBox[{
         RowBox[{"-", "\[ImaginaryI]"}], " ", "\[Phi]"}]]}], " ", 
      RowBox[{"Sin", "[", 
       FractionBox["\[Gamma]", "2"], "]"}]}]}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"normp", "="}], "*)"}], 
  RowBox[{"FullSimplify", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"vecpdag", "[", 
      RowBox[{"\[Gamma]", ",", "\[Phi]"}], "]"}], ".", 
     RowBox[{"vecp", "[", 
