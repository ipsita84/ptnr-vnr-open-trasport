Cell[BoxData[{
 RowBox[{
  RowBox[{"lim", "=", "\[Pi]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"p1", "=", 
    RowBox[{"StreamPlot", "[", 
     RowBox[{
      RowBox[{"kz", 
       RowBox[{"{", 
        RowBox[{
         FractionBox["ky", 
          SuperscriptBox[
           RowBox[{"(", 
            RowBox[{
             SuperscriptBox["ky", "2"], "+", 
             SuperscriptBox["kz", "2"]}], ")"}], "2"]], ",", 
         FractionBox["kz", 
          SuperscriptBox[
           RowBox[{"(", 
            RowBox[{
             SuperscriptBox["ky", "2"], "+", 
             SuperscriptBox["kz", "2"]}], ")"}], "2"]]}], "}"}]}], ",", 
      RowBox[{"{", 
       RowBox[{"ky", ",", 
        RowBox[{"-", "lim"}], ",", "lim"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"kz", ",", 
        RowBox[{"-", "2"}], ",", "2"}], "}"}], ",", 
      RowBox[{"StreamColorFunctionScaling", "->", "False"}], ",", 
      RowBox[{"StreamColorFunction", "->", "\"\<Rainbow\>\""}], ",", 
      RowBox[{"StreamStyle", "->", "Thick"}], ",", 
