        RowBox[{"\"\<BC-dipole\>\"", ",", "20", ",", 
         RowBox[{"FontFamily", "->", "\"\<TexMaths Roman\>\""}], ",", "Brown",
          ",", "Bold"}], "]"}]}], 
      RowBox[{"(*", "*)"}], ",", 
      RowBox[{"GridLines", "->", 
       RowBox[{"{", 
