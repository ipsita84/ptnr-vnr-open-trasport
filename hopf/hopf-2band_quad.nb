Notebook[{

Cell[CellGroupData[{
Cell["Ham for 2-band quadratic disp mode;", "Section",
 CellChangeTimes->{{3.944478004011939*^9, 3.944478004406231*^9}, 
   3.958711253494774*^9, {3.961726786010407*^9, 
   3.9617267959057417`*^9}},ExpressionUUID->"4ec52b86-93f9-448e-8c09-\
1d9c5c8cb382"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"$PrePrint", "=", 
   RowBox[{
    RowBox[{"#", "/.", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{"Csc", "[", "z_", "]"}], ":>", 
        RowBox[{"1", "/", 
         RowBox[{"Defer", "@", 
          RowBox[{"Sin", "[", "z", "]"}]}]}]}], ",", 
       RowBox[{
        RowBox[{"Sec", "[", "z_", "]"}], ":>", 
        RowBox[{"1", "/", 
         RowBox[{"Defer", "@", 
          RowBox[{"Cos", "[", "z", "]"}]}]}]}]}], "}"}]}], "&"}]}], ";", 
  RowBox[{"rep", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"kx", "\[Rule]", " ", 
      RowBox[{"k", " ", 
       RowBox[{"Sin", "[", "\[Theta]", "]"}], " ", 
       RowBox[{"Cos", "[", "\[Phi]", "]"}]}]}], ",", 
     RowBox[{"ky", "\[Rule]", " ", 
      RowBox[{"k", " ", 
       RowBox[{"Sin", "[", "\[Theta]", "]"}], " ", 
       RowBox[{"Sin", "[", "\[Phi]", "]"}]}]}], ",", 
     RowBox[{"kp", "\[Rule]", " ", 
      RowBox[{"k", " ", 
       RowBox[{"Sin", "[", "\[Theta]", "]"}]}]}], ",", 
     RowBox[{"kz", "\[Rule]", " ", 
      RowBox[{"k", " ", 
       RowBox[{"Cos", "[", "\[Theta]", "]"}]}]}], ",", 
     RowBox[{
      SuperscriptBox["\[Chi]", "2"], "->", "1"}]}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"ass", "=", 
   RowBox[{"Assumptions", "->", 
    RowBox[{
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "\[Chi]", ",", "vz", ",", "v", ",", "k", ",", "kp", ",", "\[Theta]", ",",
         "\[Phi]", ",", "\[Theta]p", ",", "\[Phi]p", ",", "kx", ",", "ky", ",",
         "kz", ",", "ek"}], "}"}], "\[Element]", " ", "Reals"}], " ", "&&", 
     "  ", 
     RowBox[{"k", ">", "0"}], " ", "&&", " ", 
     RowBox[{"kp", ">", "0"}], " ", "&&", " ", 
     RowBox[{"ek", ">", "0"}], " ", "&&", " ", 
     RowBox[{"v", ">", "0"}], " ", "&&", " ", 
     RowBox[{"vz", ">", "0"}]}]}]}], ";"}]}], "Input",
 InitializationCell->True,
 CellChangeTimes->{{3.958708281277369*^9, 3.958708282217752*^9}, {
  3.958708476128992*^9, 3.958708480351989*^9}, {3.9587114321776867`*^9, 
