Cell[BoxData[{
 RowBox[{
  RowBox[{"Clear", "[", "sigh", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"sigh", "[", 
    RowBox[{"B_", ",", "\[Mu]_", ",", "v0_", ",", 
     RowBox[{"{", 
      RowBox[{"\[Beta]inter_", ",", "\[Beta]intra_"}], "}"}]}], "]"}], ":=", 
   RowBox[{"Block", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"e", "=", "1"}], ",", "BCvec1", ",", "BCvec2", ",", "v0vec", ",", 
       RowBox[{"vf", "=", "v0"}], ",", "\[Chi]", ",", "vmvec1", ",", "vmvec2",
        ",", "matr", ",", "\[Theta]", ",", "\[Tau]1", ",", "kf1", ",", "f1", ",",
