     RowBox[{"{", 
      RowBox[{"ky", ",", 
       RowBox[{"-", "lim"}], ",", "lim"}], " ", "}"}], ",", 
     RowBox[{"PlotRange", "->", "7"}], ",", 
     RowBox[{"PlotStyle", "\[Rule]", 
      RowBox[{"{", " ", 
