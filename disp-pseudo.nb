Cell[BoxData[{
 RowBox[{
  RowBox[{"k0", "=", "1.2"}], ";", 
  RowBox[{"lim", "=", "2"}], ";", 
  RowBox[{"kz", "=", "0"}], ";", 
  RowBox[{"\[Eta]", "=", "0.5"}], ";", 
  RowBox[{"mu", "=", "0.0"}], ";", 
  RowBox[{"p", "=", 
   RowBox[{"Plot3D", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        SqrtBox[
         RowBox[{
          SuperscriptBox[
           RowBox[{"(", 
            RowBox[{
             RowBox[{"-", 
              SuperscriptBox["k0", "2"]}], "+", 
             SuperscriptBox["kx", "2"], "+", 
             SuperscriptBox["ky", "2"]}], ")"}], "2"], "+", 
          SuperscriptBox["kz", "2"]}]], "+", 
        RowBox[{"kx", " ", "\[Eta]"}]}], ",", 
