          RowBox[{"3", "/", "2"}]]}]]}]}], "}"}], "/.", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"\[Kappa]p", "->", 
       RowBox[{
        SqrtBox[
         RowBox[{
          SuperscriptBox["kx", "2"], "+", 
          SuperscriptBox["ky", "2"]}]], "-", "k0"}]}], ",", 
      RowBox[{
       RowBox[{"Cos", "[", "\[Phi]", "]"}], "->", 
