         RowBox[{"Sin", "[", "\[Gamma]", "]"}], " ", 
         RowBox[{"Cos", "[", "\[Phi]", "]"}], " "}], 
        SuperscriptBox["k", "2"]], ",", 
       FractionBox[
        RowBox[{
         RowBox[{"Cos", "[", "\[Gamma]", "]"}], " ", 
         RowBox[{"Sin", "[", "\[Gamma]", "]"}], " ", 
         RowBox[{"Sin", "[", "\[Phi]", "]"}]}], 
        SuperscriptBox["k", "2"]], ",", 
       FractionBox[
        SuperscriptBox[
         RowBox[{"Cos", "[", "\[Gamma]", "]"}], "2"], 
        SuperscriptBox["k", "2"]]}], "}"}]}]}], ";"}], 
