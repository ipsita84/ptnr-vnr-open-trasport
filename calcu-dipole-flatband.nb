Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"Clear", "[", 
    RowBox[{"tx", ",", "tz"}], "]"}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"tx", "[", 
     RowBox[{"m_", ",", "n_"}], "]"}], "=", 
    RowBox[{"(*", 
     RowBox[{
      RowBox[{"Integrate", "[", 
       RowBox[{
        FractionBox[
         RowBox[{
          SuperscriptBox[
           RowBox[{"Sin", "[", "\[Gamma]", "]"}], "m"], " ", 
          SuperscriptBox[
           RowBox[{"Cos", "[", "\[Gamma]", "]"}], "n"]}], 
         RowBox[{"1", "+", 
          RowBox[{"\[Eta]", " ", 
           RowBox[{"Sin", "[", "\[Gamma]", "]"}]}]}]], ",", 
        RowBox[{"{", 
         RowBox[{"\[Gamma]", ",", "0", ",", "\[Pi]"}], "}"}], ",", 
        RowBox[{"Assumptions", "->", 
         RowBox[{
          RowBox[{
           RowBox[{"{", 
            RowBox[{"m", ",", "n", ",", "\[Eta]"}], "}"}], "\[Element]", " ", 
           "Reals"}], " ", "&&", " ", 
          RowBox[{"m", ">", "0"}], " ", "&&", " ", 
          RowBox[{"n", ">", "0"}], " ", "&&", " ", 
          RowBox[{"0", "<", "\[Eta]", "<", "1"}]}]}]}], "]"}], "/.", 
      RowBox[{"\[Eta]", "->", 
       RowBox[{"\[Eta]x", " ", 
        RowBox[{"Cos", "[", "\[Phi]", "]"}]}]}]}], "*)"}], 
    RowBox[{
     FractionBox["1", "2"], " ", 
     RowBox[{"(", 
      RowBox[{"1", "+", 
       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{"-", "1"}], ")"}], "n"]}], ")"}], " ", 
     RowBox[{"Gamma", "[", 
      FractionBox[
       RowBox[{"1", "+", "n"}], "2"], "]"}], " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{
        RowBox[{"Gamma", "[", 
         FractionBox[
          RowBox[{"1", "+", "m"}], "2"], "]"}], " ", 
        RowBox[{"Hypergeometric2F1Regularized", "[", 
         RowBox[{"1", ",", 
          FractionBox[
           RowBox[{"1", "+", "m"}], "2"], ",", 
          RowBox[{
           FractionBox["1", "2"], " ", 
           RowBox[{"(", 
            RowBox[{"2", "+", "m", "+", "n"}], ")"}]}], ",", 
          RowBox[{
           SuperscriptBox["\[Eta]x", "2"], " ", 
           SuperscriptBox[
            RowBox[{"Cos", "[", "\[Phi]", "]"}], "2"]}]}], "]"}]}], "-", 
       RowBox[{"\[Eta]x", " ", 
        RowBox[{"Cos", "[", "\[Phi]", "]"}], " ", 
        RowBox[{"Gamma", "[", 
